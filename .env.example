# Copy this file to .env and fill in the keys you actually use.
# Voce works fully offline with zero keys set here, as long as
# transcription.engine is "local" (whisper.cpp) in settings.json and
# cleanup.enabled is false.

# Used for the LLM cleanup pass (filler-word removal, punctuation, casing).
# Leave blank to skip cleanup and paste the raw transcript instead.
ANTHROPIC_API_KEY=

# Only needed if settings.json -> transcription.engine is "groq".
GROQ_API_KEY=

# Only needed if settings.json -> transcription.engine is "openai".
OPENAI_API_KEY=
